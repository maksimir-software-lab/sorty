{
	"schemaVersion": 1,
	"id": "sorty",
	"version": "${version}",
	"name": "Sorty",
	"description": "Inventory, chest, and shulker sorting with optional instant server-side support.",
	"authors": [
		"Nico"
	],
	"license": "MIT",
	"icon": "assets/sorty/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nitodeco.sorty.Sorty"
		],
		"client": [
			"nitodeco.sorty.client.SortyClient"
		]
	},
	"mixins": [
		{
			"config": "sorty.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.7",
		"java": ">=21",
		"fabric-api": "*"
	}
}
